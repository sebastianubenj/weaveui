{
  "name": "@weaveui/ds",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": {
      "types": "./dist/types/*.d.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./preflight.css": "./dist/preflight.css",
    "./preset.css": "./dist/preset.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSES"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/index.js",
    "./src/lib/focus-intent.ts"
  ],
  "scripts": {
    "build:tokens": "node build-tokens.js",
    "tokens:normalize": "node scripts/normalize-figma-variables.js",
    "tokens:test": "node --test scripts/normalize-figma-variables.test.js",
    "build:types": "tsc -p tsconfig.types.json",
    "build:package:js": "vite build --config vite.lib.config.ts",
    "build:package:css": "vite build --config vite.styles.config.ts",
    "build:package:artifacts": "npm run build:package:js && npm run build:types && npm run build:package:css",
    "build:package": "npm run build:tokens && npm run build:package:artifacts",
    "dev": "npm run build:tokens && vite",
    "build": "npm run build:tokens && tsc -b && vite build && npm run build:package:artifacts",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run tokens:test && npm run test && npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.38.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-mcp": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^17.11.0",
    "playwright": "1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.19.0",
    "storybook": "^10.6.1",
    "style-dictionary": "^5.5.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.12"
  }
}
